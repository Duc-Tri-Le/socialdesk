{
  "name": "hatch-ts-space-social-desk",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "typecheck": "bun x tsc --noEmit -p client/tsconfig.json && bun x tsc --noEmit -p server/tsconfig.json",
    "test": "bun test",
    "build": "bun run build:server && bun run build:client",
    "build:server": "cd server && bun build ./src/actions.ts --target=bun --outfile=./dist/actions.js",
    "build:client": "vite build",
    "start": "bun run server.ts",
    "dev": "vite",
    "dev:server": "bun run --watch server.ts"
  },
  "dependencies": {
    "@hatch/space-sdk": "file:./packages/space-sdk",
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.45.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "2.15.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3",
    "vite": "^8.3.5"
  }
}
