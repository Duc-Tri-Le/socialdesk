{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "types": ["bun-types", "react", "react-dom"],
    "paths": {
      "@space/server/*": ["./server/src/*"],
      "@space/privileged": ["./server/.generated/privileged.contract"]
    }
  },
  "include": [
    "server.ts",
    "vite.config.ts",
    "client/src/**/*",
    "server/src/**/*"
  ]
}
